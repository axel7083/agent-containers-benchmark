FROM docker.io/library/node:22-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY server.js ./
RUN mkdir -p /app/data && chown node:node /app/data
USER node
ENV PORT=80
EXPOSE 80
CMD ["node", "server.js"]
